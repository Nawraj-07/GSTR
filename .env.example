# FinAxis Supabase (reuse existing project — do not create a new DB)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# GSTZen (server only — never expose to browsers)
GSTZEN_API_KEY=
GSTZEN_USERNAME=
GSTZEN_PASSWORD=

# Local export storage
GST_FILES_DIR=./data/gst

# Workbench UI (web/.env) also needs:
# VITE_SUPABASE_URL=...
# VITE_SUPABASE_ANON_KEY=...
# VITE_GSTR_API_URL=http://localhost:8789

